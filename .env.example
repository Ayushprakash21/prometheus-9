# ==============================================================================
# PROMETHEUS-9 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure values before starting production services.
# ==============================================================================

# Project & System
PROJECT_NAME="PROMETHEUS-9"
VERSION="1.0.0"
ENVIRONMENT="production"

# Backend Cryptographic Secret (Generate a strong 32+ byte string)
SECRET_KEY="generate_a_cryptographically_secure_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration (SQLite default; PostgreSQL for multi-user production)
# SQLite: sqlite+aiosqlite:///../storage/prometheus9.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/prometheus9
DATABASE_URL="sqlite+aiosqlite:///../storage/prometheus9.db"

# FFmpeg Path (leave empty if on system PATH)
FFMPEG_PATH="ffmpeg"

# Frontend Configuration
# Set to public backend URL (e.g. https://api.prometheus9.ai) or leave as /api/v1 for reverse proxy
VITE_API_BASE_URL="/api/v1"

# Third-Party Social API Credentials (Configured in Phase 5)
# YouTube Data API v3
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="https://prometheus9.pages.dev/api/v1/publishing/oauth/youtube/callback"

# Meta (Instagram & Facebook Graph API)
META_APP_ID=""
META_APP_SECRET=""

# LinkedIn API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# TikTok Developer API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# X (Twitter) API v2
TWITTER_CONSUMER_KEY=""
TWITTER_CONSUMER_SECRET=""
